{
  "expo": {
    "name": "KentBildir",
    "slug": "kentbildir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kentbildir",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.burakakblt.kentbildir",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": [
          "tr"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "KentBildir, geliştirme sunucusuna aynı yerel ağ üzerinden bağlanır."
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "tr": "./locales/tr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "KentBildir, sorun fotoğrafı seçebilmeniz için fotoğraflarınıza erişir.",
          "cameraPermission": "KentBildir, sorun fotoğrafı çekebilmeniz için kameranıza erişir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KentBildir, bildirilen sorunun yerini belirlemek için konumunuza erişir.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "KentBildir, bildirim konumunu belirleme özelliğini desteklemek için cihaz hareket etkinliği verisine erişebilir."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe469bba-bc74-4317-892a-1e28a9bf24fd"
      }
    },
    "owner": "burakakblt"
  }
}
